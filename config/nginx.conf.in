worker_processes 1;
worker_rlimit_nofile 128;
pid @ROOT@/run/nginx.pid;
error_log @ROOT@/logs/nginx.log warn;
events {
    worker_connections 64;
}
http {
    access_log off;
    default_type application/json;
    server_tokens off;
    client_max_body_size 9m;
    client_body_buffer_size 16k;
    client_body_temp_path @ROOT@/nginx-body;
    fastcgi_temp_path @ROOT@/nginx-fastcgi;
    proxy_temp_path @ROOT@/nginx-proxy;
    uwsgi_temp_path @ROOT@/nginx-uwsgi;
    scgi_temp_path @ROOT@/nginx-scgi;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 2k;
    client_header_timeout 3s;
    client_body_timeout 5s;
    send_timeout 5s;
    keepalive_timeout 0;
    reset_timedout_connection on;
    limit_conn_zone $binary_remote_addr zone=active:1m;
    limit_conn_status 429;
    server {
        listen 127.0.0.1:@PORT@;
        server_name localhost;
        limit_conn active 4;
        location ~ "^/(batches(?:/[0-9a-f]{32})?|objects/[0-9a-f]{64})$" {
            fastcgi_pass unix:@ROOT@/run/fpm.sock;
            fastcgi_connect_timeout 1s;
            fastcgi_send_timeout 5s;
            fastcgi_read_timeout 7s;
            fastcgi_buffering off;
            fastcgi_param SCRIPT_FILENAME @PUBLIC@/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param REQUEST_METHOD $request_method;
            fastcgi_param REQUEST_URI $request_uri;
            fastcgi_param QUERY_STRING $query_string;
            fastcgi_param CONTENT_TYPE $content_type;
            fastcgi_param CONTENT_LENGTH $content_length;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param SERVER_PORT $server_port;
            fastcgi_param SERVER_NAME localhost;
            fastcgi_param SERVER_PROTOCOL $server_protocol;
            fastcgi_param GATEWAY_INTERFACE CGI/1.1;
            fastcgi_param REDIRECT_STATUS 200;
        }
        location / {
            return 404;
        }
    }
}
